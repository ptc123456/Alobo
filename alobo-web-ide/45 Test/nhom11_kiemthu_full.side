    }, {
      "id": "23858c31-1e0a-4dc7-b4f5-05b88ab6176d",
      "comment": "",
      "command": "executeScript",
      "target": "const now = new Date();const today = [now.getFullYear(),String(now.getMonth()+1).padStart(2,'0'),String(now.getDate()).padStart(2,'0')].join('-');const date = \"2027-11-21\";const input = document.getElementById('booking-date');if (!input) throw new Error('Không tìm thấy ô booking-date');Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(input, date);input.dispatchEvent(new Event('input', {bubbles:true}));input.dispatchEvent(new Event('change', {bubbles:true}));const actual = document.getElementById('booking-date').value;const expected = date < today ? today : date;if (actual !== expected) throw new Error('Ngày chưa đổi: ' + actual + ', mong đợi: ' + expected);const current = document.getElementById('booking-date');current.style.outline='3px solid red';current.style.outlineOffset='3px';",
      "targets": [],
      "value": ""
    }, {
